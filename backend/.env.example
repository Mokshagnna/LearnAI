# AI Provider priority (comma-separated, first = highest priority)
# Options: groq, nvidia, gemini
PROVIDER_ORDER=groq,nvidia,gemini

# Primary AI Provider label (kept for backward compatibility)
PRIMARY_AI_PROVIDER=groq

# Overall quiz generation deadline (seconds)
OVERALL_DEADLINE_SECONDS=25.0

# Per-provider timeout budget (seconds)
PROVIDER_TIMEOUT_SECONDS=12.0

# Maximum retry attempts per provider
MAX_PROVIDER_RETRIES=1

# Maximum novelty repair attempts
MAX_NOVELTY_REPAIR_ATTEMPTS=2

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BACKUP_API_KEY=your_backup_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BACKUP_API_KEY=your_backup_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA Build Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BACKUP_API_KEY=your_backup_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-70b-instruct

# AI request configuration
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=1
AI_FALLBACK_ENABLED=true
ENABLE_LOCAL_DEMO_FALLBACK=true

# Application Runtime Environment
# Options: development, test, production
# Set to 'production' in cloud deployments to enforce fail-fast safeguards (requires DATABASE_URL and SESSION_SECRET_KEY).
# When unset or 'development', local SQLite and dev secret fallbacks are permitted.
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=*

# Reverse Proxy & Client IP Detection
# Set to 'true' when deployed behind a trusted reverse proxy (Render, Cloudflare, Nginx, Railway).
# When false (default), X-Forwarded-For is ignored to prevent client IP spoofing against rate limits.
TRUST_PROXY_HEADERS=false

# Health & Monitoring
EXPOSE_HEALTH_METRICS=false

# Rate Limiting (in-memory sliding window, requests per minute)
RATE_LIMIT_QUIZ_GEN_PER_MIN=10
RATE_LIMIT_QUIZ_SUBMIT_PER_MIN=30

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
# Leave DATABASE_URL empty/unset to use local SQLite (backend/data/learnai.db).
# Provide a valid PostgreSQL pooler connection URI for Supabase cloud environments:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Dedicated disposable test database connection for live PostgreSQL integration tests:
# TEST_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Authentication & Session Security (HMAC-SHA256 signature key)
# SESSION_SECRET_KEY=your_secure_random_hmac_secret_here
