# ==========================================
# AI PROVIDER PRIORITY
# ==========================================

# Provider execution order (comma-separated: gemini, groq, nvidia)
PROVIDER_ORDER=gemini,groq,nvidia

# Primary AI provider (first provider attempted in provider order)
PRIMARY_AI_PROVIDER=gemini

# Overall quiz generation deadline across all providers and repairs (seconds)
OVERALL_DEADLINE_SECONDS=90.0

# Per-provider execution timeout budget (seconds)
PROVIDER_TIMEOUT_SECONDS=35.0

# Maximum retry attempts per provider on transient failures
MAX_PROVIDER_RETRIES=1

# Maximum targeted replacement attempts for retake deduplication
MAX_NOVELTY_REPAIR_ATTEMPTS=2


# ==========================================
# GEMINI CONFIGURATION
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SECONDARY_API_KEY=your_secondary_gemini_api_key_here

GEMINI_MODEL=gemini-3.8-flash

# Configure only after verifying a distinct supported model
# Do not configure with the same model as GEMINI_MODEL.
# GEMINI_FALLBACK_MODEL=your_verified_gemini_fallback_model


# ==========================================
# GROQ CONFIGURATION
# ==========================================

GROQ_API_KEY=your_groq_api_key_here
GROQ_SECONDARY_API_KEY=your_secondary_groq_api_key_here

GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b


# ==========================================
# NVIDIA BUILD CONFIGURATION
# ==========================================

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_SECONDARY_API_KEY=your_secondary_nvidia_api_key_here

# Verify these model IDs against the current NVIDIA provider catalog
# meta/llama-3.1-8b-instruct is the verified active default.
# NOTE: meta/llama-3.3-70b-instruct returned HTTP 410 Gone (deprecated).
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-70b-instruct


# ==========================================
# APPLICATION RUNTIME
# ==========================================

# Runtime environment mode: development, test, or production.
# In 'production', strict fail-fast validation enforces valid DATABASE_URL and SESSION_SECRET_KEY.
ENVIRONMENT=development
DEBUG=false

# Allowed CORS origins (comma-separated or '*' for dev; specify exact frontend origins in production)
ALLOWED_ORIGINS=*

# Set to true when running behind a trusted reverse proxy (Render, Cloudflare) to trust X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Health & monitoring: set to true to expose detailed provider metrics on /api/health
EXPOSE_HEALTH_METRICS=false


# ==========================================
# RATE LIMITING
# ==========================================

# Sliding-window rate limits per IP address (requests per minute)
RATE_LIMIT_QUIZ_GEN_PER_MIN=10
RATE_LIMIT_QUIZ_SUBMIT_PER_MIN=30


# ==========================================
# DATABASE
# ==========================================

# Local development uses SQLite by default if DATABASE_URL is unset.
# DATABASE_URL=sqlite:///./learnai.db
#
# Production must use the existing persistent MySQL/TiDB connection URI:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>?ssl_ca=<path_or_system>
#
# Optional database connection pool settings:
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_CONNECT_TIMEOUT=10.0


# ==========================================
# SESSION SECURITY
# ==========================================

# Secret key for HMAC signing of student session tokens and auth cookies.
# Generate a cryptographically secure random string (e.g. openssl rand -hex 32).
# Production must retain its existing, secure SESSION_SECRET_KEY.
SESSION_SECRET_KEY=replace_with_a_secure_random_secret
