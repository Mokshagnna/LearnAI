# AI Provider priority (comma-separated, first = highest priority)
# Options: groq, nvidia, gemini
PROVIDER_ORDER=groq,nvidia,gemini

# Primary AI Provider label (kept for backward compatibility)
PRIMARY_AI_PROVIDER=groq

# Overall quiz generation deadline (seconds)
OVERALL_DEADLINE_SECONDS=25.0

# Per-provider timeout budget (seconds)
PROVIDER_TIMEOUT_SECONDS=12.0

# Maximum retry attempts per provider
MAX_PROVIDER_RETRIES=1

# Maximum novelty repair attempts
MAX_NOVELTY_REPAIR_ATTEMPTS=2

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA Build Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# AI request configuration
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=1
AI_FALLBACK_ENABLED=true
ENABLE_LOCAL_DEMO_FALLBACK=true

# Application
DEBUG=false
